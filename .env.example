# Server secrets. Copy locally only; never commit .env.local.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
APP_URL=http://localhost:3000
ALLOW_SIGNUP=false
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
CHANNEL_ENCRYPTION_KEY=
# A different random secret; required for /api/jobs/run and npm run worker.
CRON_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_GLOBAL_DAILY_LIMIT=1000
AI_PILOT_DAILY_LIMIT=50
AI_STARTER_DAILY_LIMIT=500
# Set true only after successful Stripe setup; otherwise unpaid companies use the pilot allowance.
BILLING_ENFORCED=false
RESEND_API_KEY=
EMAIL_FROM=
# Set these for one shared Meta application across multiple customer accounts.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_API_VERSION=v24.0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
DATA_RETENTION_DAYS=90
