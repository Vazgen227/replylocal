# Copy to .env.local. Never commit real credentials.
# Use a fresh PostgreSQL database. Do not point migrations at an unrelated app database.
DATABASE_URL=postgresql://replylocal:replace-with-local-password@localhost:5432/replylocal
# Exact public origin. Local development uses http; production MUST use https.
APP_URL=http://localhost:3000
# Keep false on a publicly accessible preview. Enable deliberately for pilot registration.
ALLOW_SIGNUP=false
